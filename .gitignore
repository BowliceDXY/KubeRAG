# 虚拟环境
venv/
.venv/

# 环境变量（含 API Key，不能提交）
.env

# 数据目录（ChromaDB向量数据、上传的PDF、对话历史，体积大）
data/

# 旧版路径残留（根目录 chroma_db/ 与 uploads/，现统一迁移到 data/ 下）
chroma_db/
uploads/

# Python 缓存与测试缓存
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# IDE
.idea/
.vscode/

# 系统文件
.DS_Store
Thumbs.db

# 临时文件
p0_review.diff
*.diff
