# DeepSeek 大模型 API Key（https://platform.deepseek.com）
DEEPSEEK_API_KEY=sk-your-deepseek-key

# 智谱 AI Embedding API Key（https://open.bigmodel.cn）
BIGMODEL_API_KEY=your-bigmodel-key

# Redis 地址（语义缓存；本机未装 Redis 可留空，服务会自动降级到内存缓存）
REDIS_URL=redis://localhost:6379/0

# Tavily 网络搜索 API Key（可选，用于知识库无匹配时联网搜索；不填则降级 DuckDuckGo）
# 申请地址：https://tavily.com
TAVILY_API_KEY=tvly-your-key
